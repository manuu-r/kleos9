# Reuse locally built toolchains; immutable IDs are pinned by job submission.
FROM kleos-mechanics:development AS validate
ARG KICAD_VERSION=9.0.8+dfsg-1~bpo12+1
RUN echo 'deb https://deb.debian.org/debian bookworm-backports main' > /etc/apt/sources.list.d/backports.list \
    && apt-get update && apt-get install -y --no-install-recommends -t bookworm-backports "kicad=${KICAD_VERSION}" gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=kleos-application:development /opt/flutter/bin/cache/dart-sdk /opt/dart-sdk
COPY kleos /opt/kleos/kleos
COPY kleos /usr/local/lib/python3.12/site-packages/kleos

FROM validate AS electronics
ENV UV_PYTHON_INSTALL_DIR=/opt/ato-python UV_TOOL_DIR=/opt/ato-tools UV_TOOL_BIN_DIR=/opt/toolchains/bin
RUN pip install --no-cache-dir "uv==0.9.8" \
    && uv python install 3.13.7 \
    && uv tool install --python 3.13.7 "atopile==0.12.5" \
    && chmod -R a+rX /opt/ato-python /opt/ato-tools \
    && rm -rf /root/.cache/uv
