# Development refresh of the already tested CAD dependency image. Set BASE_IMAGE
# to the inspected, locally qualified image; this is not a production build.
ARG BASE_IMAGE=kleos-native-mechanics:qualified-smoke
FROM ${BASE_IMAGE}
RUN if [ -d /opt/zephyrproject/.west ]; then cd /opt/zephyrproject && west config zephyr.base zephyr; fi
RUN if [ -d /opt/flutter ]; then pip install --no-cache-dir "PyYAML==6.0.3"; fi
COPY kleos /opt/kleos/kleos
COPY kleos /usr/local/lib/python3.12/site-packages/kleos
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 KLEOS_NATIVE_SANDBOX=1
ENTRYPOINT ["python", "-m", "kleos.native_runner"]
