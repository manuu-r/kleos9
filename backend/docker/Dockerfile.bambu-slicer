# Offline digital slicing only; no printer credentials or host/network access.
FROM ubuntu:24.04
ARG BAMBU_STUDIO_SHA256=d501b103fac5424513ec0e8d6bc145fb30719de2c7d94d7320d723740c81a7fd
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv curl ca-certificates xvfb xauth libgtk-3-0t64 libwebkit2gtk-4.1-0 \
    libgl1 libegl1 libgl1-mesa-dri libglu1-mesa libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 libsecret-1-0 \
    && rm -rf /var/lib/apt/lists/* \
    && curl --fail --location --proto '=https' --tlsv1.2 \
       https://github.com/bambulab/BambuStudio/releases/download/v02.08.02.61/BambuStudio_ubuntu24.04-v02.08.02.61-20260820225108.AppImage \
       -o /tmp/bambu.AppImage \
    && echo "${BAMBU_STUDIO_SHA256}  /tmp/bambu.AppImage" | sha256sum --check --strict \
    && chmod +x /tmp/bambu.AppImage && cd /opt && /tmp/bambu.AppImage --appimage-extract \
    && mv /opt/squashfs-root /opt/bambu && rm /tmp/bambu.AppImage \
    && useradd --uid 10001 --create-home builder \
    && python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir 'pydantic==2.14.2' 'httpx==0.28.1'
COPY kleos /opt/kleos/kleos
ENV PATH=/opt/venv/bin:/usr/bin:/bin PYTHONPATH=/opt/kleos \
    KLEOS_BAMBU_SANDBOX=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /opt/kleos
ENTRYPOINT ["python", "-m", "kleos.bambu_slicer_entry"]
