KLEOS_AUTH_MODE=development
KLEOS_DEVELOPMENT_TOKEN=replace-with-a-long-random-development-token
KLEOS_SESSION_KEY=replace-with-a-separate-long-random-signing-key
KLEOS_DATABASE_URL=postgresql+psycopg://kleos:local-development-only@localhost:5432/kleos
KLEOS_DBOS_DATABASE_URL=postgresql://kleos:local-development-only@localhost:5432/kleos_dbos
KLEOS_META_API_KEY=
# Optional Gemini provider (pick it per lane) and still used for embeddings.
GEMINI_API_KEY=
# Optional Modal Shared Endpoint for Muse Spark Open (OpenAI-compatible). The key is the
# proxy token "wk-<id>.ws-<secret>". When both are set, mechanics/electronics/coordination/review
# default to Modal; research stays on the Model API because it needs web search.
KLEOS_MODAL_LLM_URL=
KLEOS_MODAL_LLM_KEY=
KLEOS_PROJECT_BUDGET_USD=0
KLEOS_DAILY_BUDGET_USD=0

# Complete engineering responses include reasoning tokens and may take longer.
KLEOS_ENGINEERING_MAX_OUTPUT_TOKENS=32768
KLEOS_ENGINEERING_MODEL_TIMEOUT_SECONDS=600
KLEOS_ENGINEERING_STREAMING=true
KLEOS_NATIVE_SESSIONS_ENABLED=false
KLEOS_NATIVE_SESSION_MAX_STEPS=32
KLEOS_NATIVE_SESSION_MAX_SECONDS=900
KLEOS_NATIVE_SESSION_MAX_SPEND_USD=1

# Cloud default8; Compose defaults4 on a developer machine, four per project.
KLEOS_MAX_NATIVE_JOBS=4
KLEOS_MAX_NATIVE_JOBS_PER_PROJECT=4
KLEOS_NATIVE_JOB_RESERVATION_USD=0.10

# Optional organization-ID -> RentAHuman.ai API key mapping (trusted API only).
# Enables dry-run previews and owned-task observations, never hiring or payments.
KLEOS_RENTAHUMAN_API_KEYS={}
