# Local development only. Copy to .env and replace both random values.
KLEOS_ENVIRONMENT=development
KLEOS_AUTH_MODE=development
KLEOS_DEVELOPMENT_TOKEN=replace-with-a-long-random-development-token
KLEOS_SESSION_KEY=replace-with-a-separate-long-random-signing-key
KLEOS_DATABASE_URL=postgresql+psycopg://kleos:local-development-only@localhost:5432/kleos
KLEOS_DBOS_DATABASE_URL=postgresql://kleos:local-development-only@localhost:5432/kleos_dbos
KLEOS_DBOS_APPLICATION_VERSION=0.1.0
KLEOS_STORAGE_BACKEND=local
KLEOS_LOCAL_ARTIFACT_DIR=.data/artifacts
KLEOS_QDRANT_URL=http://localhost:6333
KLEOS_DEMO_MODE=true
KLEOS_EXECUTION_BACKEND=disabled
# Set these server-side to use the corresponding direct API credits.
KLEOS_META_API_KEY=
# Standard Gemini SDK name is accepted. KLEOS_GEMINI_API_KEY is also supported
# and takes priority when both are set; do not leave an empty prefixed override.
GEMINI_API_KEY=
KLEOS_META_MODEL=muse-spark-1.3
KLEOS_GEMINI_MODEL=gemini-3.8-flash
# Optional explicit default for all lanes on new projects; existing policies stay pinned.
# KLEOS_DEFAULT_MODEL_PROVIDER=google
# Zero intentionally blocks paid inference. These are allowances, not credit balances.
KLEOS_PROJECT_BUDGET_USD=0
KLEOS_DAILY_BUDGET_USD=0
# Set KLEOS_DAILY_BUDGET_USD=unlimited to remove the daily ceiling while tracking usage.
KLEOS_INVOCATION_RESERVATION_USD=1
KLEOS_EMBEDDING_RESERVATION_USD=0.01
KLEOS_NATIVE_JOB_RESERVATION_USD=1
KLEOS_MAX_ACTIVE_PROJECTS=10
KLEOS_MAX_ORG_PROJECTS=2
KLEOS_MAX_MODEL_CALLS=10
# Lightweight planning is separate from engineering generation.
KLEOS_PLANNING_MAX_OUTPUT_TOKENS=5000
KLEOS_PLANNING_MAX_MODEL_TURNS=4
KLEOS_MAX_NATIVE_JOBS=4
# Local API process count; measure against CPU, memory and database connection limits.
KLEOS_API_PROCESSES=1
# Use 0.0.0.0 for an explicitly shared LAN preview; data services stay loopback-only.
KLEOS_API_BIND_ADDRESS=127.0.0.1
KLEOS_CORS_ORIGINS=["http://localhost:5180","http://127.0.0.1:5180"]
KLEOS_FRONTEND_URL=http://localhost:5180
# Optional local diagnostics: docker compose --profile observability up -d otel
# KLEOS_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# For the Compose backend use the collector's Docker-network address instead:
# KLEOS_DOCKER_OTLP_ENDPOINT=http://otel:4318/v1/traces
# Optional licensed self-hosted Conductor: see infra/README.md.
# KLEOS_CONDUCTOR_URL=
# KLEOS_CONDUCTOR_KEY=

# Optional local development only: automatically use the development membership.
# Never allowed with Cognito or in staging/production.
KLEOS_DEVELOPMENT_NO_LOGIN=false
