# Kleos9 backend environment template.
#
# Every setting is a process environment variable named KLEOS_<SETTING>. Copy this file somewhere PRIVATE (for
# example ~/.config/kleos/local-runtime.env, mode 0600), fill in the values, then either
#   set -a; . ~/.config/kleos/local-runtime.env; set +a          # shell / .venv/bin/python -m kleos.cli ...
#   docker compose --env-file ~/.config/kleos/local-runtime.env -f compose.yaml up -d   # container stack
#
# Do NOT save it as backend/.env. That path is the old backend's file and is read ONLY for the three provider
# credentials (KLEOS_META_API_KEY, KLEOS_MODAL_API_KEY/KLEOS_MODAL_LLM_KEY, KLEOS_MODAL_BASE_URL/KLEOS_MODAL_LLM_URL);
# its database, authentication and policy values are never inherited.
#
# Values below are placeholders. Lines starting with "# " are optional examples; JSON values use single quotes.
# Never commit a filled-in copy.

# ---- Required ------------------------------------------------------------------------------------------------
# A FRESH PostgreSQL database for this backend. Never the old backend's database: `kleos.cli migrate` refuses a
# database that carries another schema's migration history.
KLEOS_DATABASE_URL=postgresql+psycopg://kleos:change-me@localhost:5432/kleos_rewrite
# Compose only: the password for the bundled postgres service (must match the password in the URL above).
KLEOS_POSTGRES_PASSWORD=change-me
# Persistent signing secret, at least 32 characters:  openssl rand -hex 32
KLEOS_SESSION_SECRET=
# One-time token for creating the first owner from the sign-in page:  openssl rand -hex 32
KLEOS_SETUP_TOKEN=

# ---- Environment and sign-in ---------------------------------------------------------------------------------
# development | test | production
KLEOS_ENVIRONMENT=development
# Local-only convenience that skips sign-in. Refused outside development/test.
KLEOS_DEVELOPMENT_NO_LOGIN=false

# ---- Model providers (inference uses Meta and Modal only) -------------------------------------------------------
# Meta API key. With it set, the platform installs the Muse Spark model automatically.
KLEOS_META_API_KEY=
# Optional Modal-hosted Muse Spark Open (set both). The older names KLEOS_MODAL_LLM_KEY / KLEOS_MODAL_LLM_URL also work.
KLEOS_MODAL_API_KEY=
KLEOS_MODAL_BASE_URL=
# meta | modal: which installation is the default when both are configured.
KLEOS_MODEL_PROVIDER=meta
# Explicit single Modal rate-limit fallback (never switches providers silently otherwise).
# KLEOS_MODAL_RATE_LIMIT_FALLBACK_KEY=
# Hard ceilings per objective (cost in millionths of a dollar: 5000000 = $5).
KLEOS_MAX_MODEL_CALLS=100
KLEOS_MAX_MODEL_COST_MICRO_USD=5000000
# Overrides for the installed models (advanced).
# KLEOS_MODEL_CATALOG='[]'
# KLEOS_TEXT_MODEL_KEY=
# KLEOS_VISION_MODEL_KEY=

# ---- Origins and companion previews -----------------------------------------------------------------------------
KLEOS_FRONTEND_ORIGIN=http://localhost:5180
KLEOS_API_ORIGIN=http://localhost:8000
KLEOS_PREVIEW_ORIGIN=http://localhost:8004
# Separate-origin hosting of generated companion apps; needs three distinct origins above.
KLEOS_COMPANION_PREVIEW_ENABLED=false
# KLEOS_COMPANION_PREVIEW_TTL_SECONDS=300

# ---- Storage and run limits --------------------------------------------------------------------------------------
KLEOS_ARTIFACT_ROOT=.data/rewrite/artifacts
# KLEOS_MAX_TASKS=32
# KLEOS_MAX_ACTIONS=24
# KLEOS_MAX_RUN_SECONDS=1800
# KLEOS_MAX_CONTEXT_CHARS=60000

# ---- Native engineering tools (isolated Docker jobs; local development only) -------------------------------------
# One entry per lane, each bound to an exact image ID and its qualification record. Build the images from
# src/kleos/execution/toolchains and qualify them (src/kleos/execution/qualification/LINUX.md).
# KLEOS_NATIVE_TOOLS='[{"capability":"cad","imageDigest":"sha256:<image id>","providerVersion":"local","qualified":true,"qualificationReference":"/path/to/cad-linux-strict-2026-11-03.json"}]'
# KLEOS_NATIVE_CONTROL_ROOT=.data/rewrite/native
# KLEOS_DOCKER_SOCKET=/var/run/docker.sock
# Only for Docker Desktop's qualified compatibility mode:
# KLEOS_NATIVE_DOCKER_DESKTOP_COMPATIBILITY=false
# Length of one native job in seconds (60-1800). Slow models need more than the 600 default.
# KLEOS_NATIVE_SESSION_SECONDS=600
# Shared capacity for native, checker and slicer jobs on one Docker host.
# KLEOS_NATIVE_CAPACITY_POOL_ID=local-docker
# KLEOS_NATIVE_CAPACITY_CPUS=4
# KLEOS_NATIVE_CAPACITY_MEMORY_BYTES=6442450944
# KLEOS_NATIVE_CAPACITY_SCRATCH_BYTES=5368709120
# KLEOS_NATIVE_CAPACITY_MAX_JOBS=2

# ---- Independent checks, simulation and slicing (each needs its own qualified image) -----------------------------
# KLEOS_CAD_CHECKER_INSTALLATION='{"imageDigest":"sha256:<image id>","qualificationReference":"<record>"}'
# KLEOS_PCB_CHECKER_INSTALLATION='{"imageDigest":"sha256:<image id>","qualificationReference":"<record>"}'
# KLEOS_FIRMWARE_CHECKER_INSTALLATION='{"imageDigest":"sha256:<image id>","qualificationReference":"<record>"}'
# KLEOS_APPLICATION_CHECKER_INSTALLATION='{"imageDigest":"sha256:<image id>","qualificationReference":"<record>"}'
# KLEOS_CHECKER_CONTROL_ROOT=.data/rewrite/checkers
# Advisory circuit simulation (see src/kleos/validation/simulation/README.md):
# KLEOS_SIMULATION_INSTALLATION='{"imageDigest":"sha256:<image id>","qualificationReference":"<record>"}'
# KLEOS_SIMULATION_CONTROL_ROOT=.data/rewrite/simulation
# Offline slicing for Bambu print preparation:
# KLEOS_SLICER_INSTALLATION='{"image":"sha256:<image id>","report":"<record>","dockerDesktop":false}'
# KLEOS_SLICER_CONTROL_ROOT=.data/rewrite/slicing

# ---- Integrations (read-only discovery and drafts; purchasing and hiring stay simulated) -------------------------
# KLEOS_EXTERNAL_INSTALLATIONS='[]'
# KLEOS_EXTERNAL_CREDENTIALS='{}'
# KLEOS_WEB_SEARCH_INSTALLATION=
# KLEOS_MCP_INSTALLATIONS='[]'
# KLEOS_MCP_CONTROL_ROOT=.data/rewrite/mcp
# Local Bambu printer connections (needs an encryption key for stored credentials):
# KLEOS_BAMBU_LOCAL_ENABLED=false
# KLEOS_PRINTER_ENCRYPTION_KEY=
# Physical actions (orders, hiring, printing, shipping) stay blocked by server policy. Leave this false.
KLEOS_PHYSICAL_ACTIONS_ENABLED=false

# ---- Container stack (compose.yaml only) ----------------------------------------------------------------------------
# KLEOS_CONTROL_IMAGE=kleos-control:local
# KLEOS_LOCAL_API_PORT=8000
# KLEOS_LOCAL_PREVIEW_PORT=8004

# ---- Opt-in test runs (see backend/README.md "Test layout"). All unset by default; none is needed to run the app. ---
# KLEOS_TEST_POSTGRES_URL=postgresql://kleos:change-me@localhost:5432/kleos_test
# KLEOS_TEST_NGSPICE=1
# KLEOS_TEST_SIM_IMAGE=sha256:<simulation image id>
# KLEOS_TEST_REAL_NATIVE=1
# A live-model run costs money: it needs all three of these.
# KLEOS_TEST_LIVE_MODEL=1
# KLEOS_LIVE_MAX_COST_USD=5
# KLEOS_LIVE_MAX_CALLS=60
# KLEOS_LIVE_REPORT_DIR=/tmp/kleos-live-reports
# Frontend: live route test against a running development backend (kleos-ui/test/backend_live_contract_test.dart).
# KLEOS_E2E_API=http://127.0.0.1:8000/api/v1
