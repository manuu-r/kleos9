# Copy to terraform.tfvars (gitignored). Contains no credentials: those are SSM parameters.
region = "us-east-1"
name   = "kleos9" # must differ from the legacy kleos9-production stack while it exists

# CloudFront aliases are globally unique. While the legacy stack still owns app/api.kleos9.com,
# provision with temporary hostnames (for example app2/api2) and switch after cutover.
app_hostname     = "app.kleos9.com"
api_hostname     = "api.kleos9.com"
preview_hostname = "preview.kleos9.com"

# Leave empty for the first apply (storage, database, host only); set to a pushed digest to add the API.
control_image = ""
# control_image = "750420487076.dkr.ecr.us-east-1.amazonaws.com/kleos9/control@sha256:..."

alert_email        = ""
monthly_budget_usd = 50
