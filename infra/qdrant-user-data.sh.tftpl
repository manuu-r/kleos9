#!/bin/bash
set -euo pipefail
dnf install -y docker
systemctl enable --now docker
device="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${volume_id}"
for i in $(seq 1 180); do [ -b "$device" ] && break; sleep 5; done
[ -b "$device" ]
if ! blkid "$device"; then mkfs.ext4 "$device"; fi
mkdir -p /var/lib/qdrant
mount "$device" /var/lib/qdrant
uuid=$(blkid -s UUID -o value "$device")
echo "UUID=$uuid /var/lib/qdrant ext4 defaults,nofail 0 2" >> /etc/fstab
mkdir -p /var/lib/qdrant/storage /var/lib/qdrant/snapshots
key=$(aws secretsmanager get-secret-value --region ${region} --secret-id '${secret_arn}' --query SecretString --output text)
printf 'QDRANT__SERVICE__API_KEY=%s\n' "$key" > /etc/qdrant.env
chmod 600 /etc/qdrant.env
cat > /etc/systemd/system/qdrant.service <<'UNIT'
[Unit]
After=docker.service
Requires=docker.service
[Service]
Restart=always
ExecStartPre=-/usr/bin/docker rm qdrant
ExecStart=/usr/bin/docker run --name qdrant --env-file /etc/qdrant.env -p 6333:6333 -v /var/lib/qdrant/storage:/qdrant/storage -v /var/lib/qdrant/snapshots:/qdrant/snapshots qdrant/qdrant:v1.15.5
ExecStop=/usr/bin/docker stop qdrant
[Install]
WantedBy=multi-user.target
UNIT
cat > /usr/local/bin/kleos-qdrant-snapshot <<'SCRIPT'
#!/bin/bash
set -euo pipefail
key=$(sed -n 's/^QDRANT__SERVICE__API_KEY=//p' /etc/qdrant.env)
name=$(curl --fail --silent -X POST -H "api-key: $key" http://localhost:6333/snapshots | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["name"])')
case "$name" in *"/"*|*".."*) exit 1;; esac
aws s3 cp "/var/lib/qdrant/snapshots/$name" "s3://${bucket}/qdrant-snapshots/$name" --region ${region}
find /var/lib/qdrant/snapshots -type f -mtime +7 -delete
SCRIPT
chmod 700 /usr/local/bin/kleos-qdrant-snapshot
cat > /etc/systemd/system/kleos-qdrant-snapshot.service <<'UNIT'
[Service]
Type=oneshot
ExecStart=/usr/local/bin/kleos-qdrant-snapshot
UNIT
cat > /etc/systemd/system/kleos-qdrant-snapshot.timer <<'UNIT'
[Timer]
OnCalendar=daily
Persistent=true
[Install]
WantedBy=timers.target
UNIT
systemctl daemon-reload
systemctl enable --now qdrant kleos-qdrant-snapshot.timer
